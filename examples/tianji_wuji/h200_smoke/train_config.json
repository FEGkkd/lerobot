{
  "dataset": {
    "repo_id": "fegkkd/bag_v3",
    "revision": "e82d64b44deff9dc4d42c149e6048010a5427ccd",
    "root": null,
    "video_backend": "pyav",
    "return_uint8": true,
    "split_manifest": "examples/tianji_wuji/h200_smoke/splits/split_manifest.json",
    "task_prompt_map": {"bag_batter": "Put the drink bottle into the bag."},
    "exclude_features": ["observation.teleop_input"]
  },
  "policy": {
    "type": "groot",
    "device": "cuda",
    "base_model_path": "nvidia/GR00T-N1.7-3B",
    "embodiment_tag": "new_embodiment",
    "chunk_size": 16,
    "n_action_steps": 16,
    "use_relative_actions": false,
    "use_bf16": true,
    "dtype": "float32",
    "tune_llm": false,
    "tune_visual": false,
    "tune_top_llm_layers": 0,
    "tune_projector": true,
    "tune_diffusion_model": true,
    "tune_vlln": true,
    "optimizer_lr": 0.0001,
    "push_to_hub": false,
    "input_features": {
      "observation.state": {"type": "STATE", "shape": [54]},
      "observation.images.head_left": {"type": "VISUAL", "shape": [3, 640, 640]},
      "observation.images.head_right": {"type": "VISUAL", "shape": [3, 640, 640]},
      "observation.images.wrist_left": {"type": "VISUAL", "shape": [3, 480, 640]},
      "observation.images.wrist_right": {"type": "VISUAL", "shape": [3, 480, 640]}
    },
    "output_features": {"action": {"type": "ACTION", "shape": [54]}}
  },
  "batch_size": 1,
  "steps": 100,
  "stop_after_steps": 50,
  "seed": 42,
  "num_workers": 2,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "accelerator": {"mixed_precision": "bf16", "gradient_accumulation": {"steps": 1}},
  "output_dir": "outputs/train/tianji_wuji_h200_smoke",
  "job_name": "tianji_wuji_h200_partial_smoke100",
  "save_checkpoint": true,
  "save_freq": 50,
  "log_freq": 1,
  "eval_steps": 25,
  "max_eval_samples": 32,
  "env_eval_freq": 0,
  "local_metrics": true,
  "wandb": {"enable": false}
}
